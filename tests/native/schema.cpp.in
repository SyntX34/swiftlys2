#include <cassert>
#include <cstdint>
#include <cstring>
#include <iostream>
#include <string>
#include <string_view>
#include <unordered_map>
#include <api/memory/virtual/call.h>

using uint8 = uint8_t;
using ChangeAccessorFieldPathIndex_t = int32_t;
struct NetworkStateChangedData {
    uint32_t offset;
    int32_t arrayIndex;
    ChangeAccessorFieldPathIndex_t path;
    explicit NetworkStateChangedData(uint32_t offset, int32_t arrayIndex = -1, int32_t path = -1)
        : offset(offset), arrayIndex(arrayIndex), path(path) {}
};
struct CEntityInstance {
    virtual void NetworkStateChanged(const NetworkStateChangedData& data) = 0;
};
struct Entity : CEntityInstance {
    int calls = 0;
    uint32_t lastOffset = 0;
    int32_t lastPath = -1;
    void NetworkStateChanged(const NetworkStateChangedData& data) override {
        calls++; lastOffset = data.offset; lastPath = data.path;
    }
};
@FIELD@
@NETWORKVAR@
@CHAINER@
std::unordered_map<uint64_t, SchemaField> offsets;
std::unordered_map<void*, int32_t> networkVarStateChangedOffsets;
struct CSDKSchema { void SetStateChanged(void*, uint64_t); };
enum class SchemaTypeCategory_t { SCHEMA_TYPE_BUILTIN, SCHEMA_TYPE_DECLARED_CLASS };
struct SchemaType { SchemaTypeCategory_t m_eTypeCategory = SchemaTypeCategory_t::SCHEMA_TYPE_BUILTIN; };
SchemaType builtinType;
struct SchemaClassFieldData_t {
    const char* m_pszName;
    int32_t m_nSingleInheritanceOffset;
    SchemaType* m_pType = &builtinType;
};
struct CSchemaClassInfo;
struct BaseClass { CSchemaClassInfo* m_pClass; };
struct CSchemaClassInfo {
    const char* m_pszName;
    int m_nBaseClassCount;
    BaseClass* m_pBaseClasses;
    int m_nFieldCount;
    SchemaClassFieldData_t* m_pFields;
    int m_nSize = 8;
};
using SchemaClassInfoData_t = CSchemaClassInfo;
struct CSchemaType_DeclaredClass : SchemaType { CSchemaClassInfo* m_pClassInfo; };
uint32_t hash_32_fnv1a_const(const char* s) {
    uint32_t hash = 2166136261;
    while (*s) hash = (hash ^ static_cast<uint8_t>(*s++)) * 16777619;
    return hash;
}
uint64_t key(const char* cls, const char* field) {
    return (uint64_t(hash_32_fnv1a_const(cls)) << 32) | hash_32_fnv1a_const(field);
}
struct BinLib {
    std::unordered_map<std::string, void*> vtables;
    std::unordered_map<void*, uint64_t> indices;
    int FindVtable(const char*, const char* name, void** out) {
        auto it = vtables.find(name);
        if (it == vtables.end()) return -4;
        *out = it->second; return 0;
    }
    int FindVtableNested2(const char* binary, const char* owner, const char* field, void** out) {
        return FindVtable(binary, (std::string(owner) + "::" + field).c_str(), out);
    }
    int FindNetworkvarVtableStatechanged(uint64_t table, uint64_t* out) {
        auto it = indices.find(reinterpret_cast<void*>(table));
        if (it == indices.end()) return -4;
        *out = it->second; return 0;
    }
} binLib;
BinLib* g_pS2BinLib = &binLib;
std::string chainEntityIndex = "__m_pChainEntity";
@READER@
@DISPATCH@

int wrapperCalls = 0;
void* receivedThis = nullptr;
uint32_t receivedOffset = 0;
void embeddedChanged(void* self, const NetworkStateChangedData* data) {
    wrapperCalls++;
    receivedThis = self;
    // Like the engine thunk, translate the local offset to the enclosing owner.
    receivedOffset = 16 + data->offset;
}
void wrongOwnerSlot(void*, const NetworkStateChangedData*) {
    assert(false && "wrapper slot was invoked on its owner");
}
void read(CSchemaClassInfo& info) { CSchemaType_DeclaredClass type{{}, &info}; ReadClasses(&type); }

int main() {
    CSDKSchema schema;
    void* ownerVtable[] = {nullptr, reinterpret_cast<void*>(&wrongOwnerSlot)};
    void* embeddedVtable[] = {nullptr, reinterpret_cast<void*>(&embeddedChanged)};
    void* baseVtable[] = {nullptr, nullptr};
    binLib.vtables["Owner"] = ownerVtable;
    binLib.vtables["Fog"] = baseVtable;
    binLib.vtables["Owner::NetworkVar_fog"] = embeddedVtable;
    binLib.indices[embeddedVtable] = 1;
    SchemaClassFieldData_t fogFields[] = {{"start", 12}};
    CSchemaClassInfo fog{"Fog", 0, nullptr, 1, fogFields};
    read(fog); // Metadata order must not affect runtime wrapper resolution.
    SchemaClassFieldData_t ownerFields[] = {{"fog", 16}};
    CSchemaClassInfo owner{"Owner", 0, nullptr, 1, ownerFields};
    read(owner);
    alignas(void*) uint8_t storage[64]{};
    *reinterpret_cast<void***>(storage) = ownerVtable;
    *reinterpret_cast<void***>(storage + 16) = embeddedVtable;
    schema.SetStateChanged(storage, key("Owner", "fog"));
    assert(wrapperCalls == 1 && receivedThis == storage + 16 && receivedOffset == 16);
    schema.SetStateChanged(storage + 16, key("Fog", "start"));
    assert(wrapperCalls == 2 && receivedThis == storage + 16 && receivedOffset == 28);

    SchemaClassFieldData_t entityFields[] = {{"health", 40}};
    CSchemaClassInfo entityBase{"CEntityInstance", 0, nullptr, 0, nullptr};
    BaseClass entityBases[] = {{&entityBase}};
    CSchemaClassInfo entityInfo{"Entity", 1, entityBases, 1, entityFields};
    read(entityInfo);
    Entity entity;
    schema.SetStateChanged(&entity, key("Entity", "health"));
    assert(entity.calls == 1 && entity.lastOffset == 40);

    SchemaClassFieldData_t serviceFields[] = {{"__m_pChainEntity", 0}, {"value", 44}};
    CSchemaClassInfo service{"Service", 0, nullptr, 2, serviceFields};
    read(service);
    CNetworkVarChainer chainer{};
    chainer.m_pEntity = &entity;
    chainer.m_PathIndex = 7;
    schema.SetStateChanged(&chainer, key("Service", "value"));
    assert(entity.calls == 2 && entity.lastOffset == 44 && entity.lastPath == 7);
    chainer.m_pEntity = nullptr;
    schema.SetStateChanged(&chainer, key("Service", "value"));
    assert(entity.calls == 2);

    BaseClass serviceBases[] = {{&service}};
    SchemaClassFieldData_t derivedFields[] = {{"derived", 48}};
    CSchemaClassInfo derived{"DerivedService", 1, serviceBases, 1, derivedFields};
    read(derived);
    chainer.m_pEntity = &entity;
    schema.SetStateChanged(&chainer, key("DerivedService", "derived"));
    assert(entity.calls == 3 && entity.lastOffset == 48 && entity.lastPath == 7);

    SchemaClassFieldData_t plainFields[] = {{"byte", 0}};
    CSchemaClassInfo plain{"Plain", 0, nullptr, 1, plainFields};
    read(plain);
    uint8_t byte = 1; // ASan catches even a vptr read from this one-byte object.
    schema.SetStateChanged(&byte, key("Plain", "byte"));
    // A standalone polymorphic base with no enclosing wrapper has no owner to notify.
    void** standaloneVtable = baseVtable;
    schema.SetStateChanged(&standaloneVtable, key("Fog", "start"));
    schema.SetStateChanged(nullptr, key("Owner", "fog"));
    schema.SetStateChanged(storage, 0);
    assert(wrapperCalls == 2 && entity.calls == 3);
    assert(offsets.at(key("Plain", "byte")).m_nStateChangedOffset == -1);
    std::cout << "Schema notification regressions passed\n";
}
